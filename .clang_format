
Language: Cpp
BasedOnStyle: LLVM

# --- 3.1. Szerokość linii ---
ColumnLimit: 80

# --- 3.2.1. Wcięcia (Wymuszone twarde tabulacje) ---
IndentWidth: 4
TabWidth: 4
# Wymusza używanie znaków tabulacji (\t)
UseTab: Always

# Cofnięcie modyfikatorów dostępu o jedną szerokość wcięcia (1 tab) do tyłu
AccessModifierOffset: -4
# Brak wcięć dla zawartości przestrzeni nazw
NamespaceIndentation: None


SpaceBeforeAssignmentOperators: true

# --- 3.5.1. Deklaracje wskaźników i referencji ---
PointerAlignment: Right
ReferenceAlignment: Right

# --- 3.5.2. Instrukcje sterujące - klamry ---
BreakBeforeBraces: Custom
BraceWrapping:
  AfterControlStatement: Never  
  AfterFunction: false          
  AfterStruct: false            
  AfterClass: false             
  AfterEnum: false              
  AfterUnion: false             
  AfterNamespace: false         
  BeforeElse: true              # '}\nelse {'
  BeforeWhile: false            
  BeforeCatch: true             # '}\ncatch (...) {'

# Zapobieganie jednolinijkowym instrukcjom
AllowShortBlocksOnASingleLine: false
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: None

# --- 3.4. Sortowanie include'ów ---
SortIncludes: true

# --- Inne zasady spójności ---
Standard: Latest
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignOperands: Align
AlignTrailingComments: true
